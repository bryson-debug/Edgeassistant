# Copy to .env.local for local development. Never commit real values.
ANTHROPIC_API_KEY=
AIRTABLE_TOKEN=
# Optional. Defaults to claude-haiku-4-5.
MODEL=
# Comma-separated list of origins allowed to embed the assistant in an iframe.
ALLOWED_PARENT_ORIGINS=https://thatmusicteacher.thrivecart.com
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Password for the admin chat log at /admin. Admin is off when unset.
ADMIN_PASSWORD=
# Optional secret used to hash visitor IPs in the log (falls back to ADMIN_PASSWORD).
LOG_SALT=
